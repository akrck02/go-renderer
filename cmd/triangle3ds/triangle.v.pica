; Places a vertex with the projection and model-view matrices and passes its colour on.

.fvec projection[4]
.fvec modelView[4]

.constf numbers(0.0, 1.0, 0.0, 0.0)
.alias  ones numbers.yyyy

.out outPosition position
.out outColour color

.alias inPosition v0
.alias inColour   v1

.proc main
	; r0 = (position, 1)
	mov r0.xyz, inPosition
	mov r0.w,   ones

	; r1 = modelView * r0
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outPosition = projection * r1
	dp4 outPosition.x, projection[0], r1
	dp4 outPosition.y, projection[1], r1
	dp4 outPosition.z, projection[2], r1
	dp4 outPosition.w, projection[3], r1

	mov outColour, inColour
	end
.end
