; ctr's overlay shader: rectangles of the overlay's atlas, placed in screen pixels by an
; orthographic projection, with their texture position and colour passed on. The colour stage
; multiplies the colour's alpha by the atlas's coverage (flat.go).

.fvec projection[4]

.constf numbers(0.0, 1.0, -0.5, 0.0)
.alias ones   numbers.yyyy
.alias middle numbers.zzzz ; halfway in depth, well inside the clip range

.out outPosition position
.out outTexture  texcoord0
.out outColour   color

.alias inPosition v0 ; x, y in pixels
.alias inTexture  v1
.alias inColour   v2

.proc main
	mov r0.xy, inPosition
	mov r0.z, middle
	mov r0.w, ones
	dp4 outPosition.x, projection[0], r0
	dp4 outPosition.y, projection[1], r0
	dp4 outPosition.z, projection[2], r0
	dp4 outPosition.w, projection[3], r0
	mov outTexture, inTexture
	mov outColour, inColour
	end
.end
